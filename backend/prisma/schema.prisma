generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bank {
  id               Int               @id @default(autoincrement())
  slug             String            @unique
  nameRu           String
  nameTj           String
  nameUz           String
  shortName        String
  logo             String?
  isActive         Boolean           @default(true)
  exchangeRate     ExchangeRate?
  rates            Rate[]
  rateHistory      RateHistory[]
  withdrawalLimits WithdrawalLimit[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// Every rate a bank publishes, one row per currency per kind of operation.
//
// Banks do not have "a rate". Alif pays 0.0900 for a rouble at the counter and 0.1086 by transfer —
// 20% apart, both published, both true for different people. Dushanbe City and Arvand differ the
// same way. A single buy/sell pair per currency, which is what ExchangeRate holds, therefore has to
// be wrong for somebody no matter which figure is chosen; this table is what makes it possible to
// be right for everybody.
//
// ExchangeRate is kept as the headline shown on a card and in comparisons, now labelled with the
// type it came from, so the existing pages, sitemap and converter keep working while the full
// picture lives here.
model Rate {
  id          Int      @id @default(autoincrement())
  bankId      Int
  bank        Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  currency    String
  // cash | transfer | card | noncash | legal | loan | nbt — see RATE_TYPES in rate-types.js, which
  // is the single place the vocabulary is defined and where each bank's own naming is mapped onto
  // it. Stored as text rather than an enum because SQLite has none and a new type must not need a
  // migration to appear.
  type        String
  buy         Float
  // Null only for the NBT reference, which publishes one figure rather than a spread.
  sell        Float?
  sourceLabel String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bankId, currency, type])
  @@index([bankId, type])
}

model ExchangeRate {
  id          Int      @id @default(autoincrement())
  bankId      Int      @unique
  bank        Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  usdBuy      Float
  usdSell     Float
  rubBuy      Float
  rubSell     Float
  eurBuy      Float
  eurSell     Float
  sourceLabel String
  // Which of the bank's published rates this headline was taken from. Showing a number without
  // saying whether it is the counter rate or the transfer rate is the flaw this whole change
  // exists to remove — a person holding cash and a person sending a transfer are quoted different
  // figures, and an unlabelled one silently serves the wrong half of them.
  rateType    String   @default("transfer")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RateHistory {
  id          Int      @id @default(autoincrement())
  bankId      Int
  // Without this relation a reseed left the history behind while the banks were recreated, and
  // SQLite hands out freed ids again — so a new bank could inherit a deleted one's history and the
  // card would draw a confident movement arrow computed from another bank's rates. Measured on the
  // live database before the fix: 21 orphaned rows out of 118.
  bank        Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  usdBuy      Float
  usdSell     Float
  rubBuy      Float
  rubSell     Float
  eurBuy      Float
  eurSell     Float
  sourceLabel String
  // Recorded so a movement is never derived across two different kinds of rate. When a bank starts
  // publishing an API and the headline moves from the counter figure to the transfer figure, the
  // numbers jump for a reason that has nothing to do with the market — comparing them would print
  // a confident arrow describing an event that did not happen.
  rateType    String   @default("transfer")
  recordedAt  DateTime @default(now())

  @@index([bankId, recordedAt])
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  route     String
  status    Int
  message   String
  // Errors arrive in bursts — one broken page hit by a crawler produces hundreds of identical
  // entries. Grouping on a fingerprint keeps the log readable and lets alerts fire once per
  // distinct problem instead of once per request.
  fingerprint String
  count     Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([fingerprint])
  @@index([lastSeen])
}

model DailyStat {
  id     Int      @id @default(autoincrement())
  day    String
  metric String
  path   String   @default("")
  count  Int      @default(0)

  // Aggregated per day rather than stored per event: a few rows a day instead of one per visit,
  // so the SQLite file stays small no matter how much traffic arrives.
  @@unique([day, metric, path])
  @@index([day])
}

model ScraperRun {
  id           Int       @id @default(autoincrement())
  trigger      String
  status       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  banksUpdated Int       @default(0)
  banksChanged Int       @default(0)
  banksSkipped Int       @default(0)
  error        String?

  @@index([startedAt])
}

model WithdrawalLimit {
  id           Int      @id @default(autoincrement())
  bankId       Int
  bank         Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  cardName     String
  cardType     String
  // Banks state their limits in whatever period they choose, and forcing one into another's field
  // is how a weekly allowance becomes a daily one on somebody's screen. Every period is optional;
  // only what a bank actually published is stored, and only that is drawn.
  weeklyLimit  String?
  counterLimit String?
  dailyLimit   String?
  monthlyLimit String?
  commission   String?
  ownAtmNote   String?
  otherAtmNote String?
  abroadNote   String?
  noteRu       String?
  noteTj       String?
  noteUz       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bankId])
}

