generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bank {
  id               Int               @id @default(autoincrement())
  slug             String            @unique
  nameRu           String
  nameTj           String
  nameUz           String
  shortName        String
  logo             String?
  isActive         Boolean           @default(true)
  exchangeRate     ExchangeRate?
  withdrawalLimits WithdrawalLimit[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ExchangeRate {
  id          Int      @id @default(autoincrement())
  bankId      Int      @unique
  bank        Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  usdBuy      Float
  usdSell     Float
  rubBuy      Float
  rubSell     Float
  eurBuy      Float
  eurSell     Float
  sourceLabel String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RateHistory {
  id          Int      @id @default(autoincrement())
  bankId      Int
  usdBuy      Float
  usdSell     Float
  rubBuy      Float
  rubSell     Float
  eurBuy      Float
  eurSell     Float
  sourceLabel String
  recordedAt  DateTime @default(now())

  @@index([bankId, recordedAt])
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  route     String
  status    Int
  message   String
  // Errors arrive in bursts — one broken page hit by a crawler produces hundreds of identical
  // entries. Grouping on a fingerprint keeps the log readable and lets alerts fire once per
  // distinct problem instead of once per request.
  fingerprint String
  count     Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([fingerprint])
  @@index([lastSeen])
}

model DailyStat {
  id     Int      @id @default(autoincrement())
  day    String
  metric String
  path   String   @default("")
  count  Int      @default(0)

  // Aggregated per day rather than stored per event: a few rows a day instead of one per visit,
  // so the SQLite file stays small no matter how much traffic arrives.
  @@unique([day, metric, path])
  @@index([day])
}

model ScraperRun {
  id           Int       @id @default(autoincrement())
  trigger      String
  status       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  banksUpdated Int       @default(0)
  banksChanged Int       @default(0)
  banksSkipped Int       @default(0)
  error        String?

  @@index([startedAt])
}

model WithdrawalLimit {
  id           Int      @id @default(autoincrement())
  bankId       Int
  bank         Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  cardName     String
  cardType     String
  dailyLimit   String
  monthlyLimit String
  commission   String
  ownAtmNote   String
  otherAtmNote String
  abroadNote   String
  noteRu       String
  noteTj       String
  noteUz       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bankId])
}

