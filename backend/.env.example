PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL="file:./dev.db"
ADMIN_KEY=change-me-to-a-long-random-secret
# How often to poll NBT for fresh rates, in minutes. Set to 0 to disable auto-updates.
SCRAPE_INTERVAL_MINUTES=15

# Optional alerts to Telegram. Create a bot with @BotFather to get the token, then message the
# bot once and read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
# Leave both empty to keep alerts switched off — that is the expected setup in development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

